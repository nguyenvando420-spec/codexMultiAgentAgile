#!/bin/sh
# Select a compatible interpreter without changing the user's Python installation.
set -eu
toolkit_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for candidate in "${AGILE_PYTHON:-}" python3 /opt/homebrew/bin/python3; do
    if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            exec "$candidate" "$toolkit_dir/scripts/team.py" "$@"
        fi
    fi
done
echo 'Python 3.11+ is required. Set AGILE_PYTHON to its executable path.' >&2
exit 1
